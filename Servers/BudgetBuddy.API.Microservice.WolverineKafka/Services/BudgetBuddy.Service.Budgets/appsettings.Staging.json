{
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": ""
  },
  "Keycloak": {
    "Authority": "",
    "Audience": "budgetbuddy-api",
    "RequireHttps": true
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Kafka": {
    "BootstrapServers": "",
    "SecurityProtocol": "SaslSsl",
    "SaslMechanism": "ScramSha512",
    "SaslUsername": "",
    "SaslPassword": "",
    "SslCaLocation": ""
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "",
    "SamplingRatio": 0.5
  },
  "Seq": {
    "ServerUrl": ""
  },
  "BackgroundJobs": {
    "Enabled": true,
    "BudgetAlerts": {
      "Enabled": true,
      "CronExpression": "0 0 8 * * ?"
    },
    "BudgetsOutboxProcessor": {
      "CronExpression": "0/30 * * * * ?"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "RateLimit": {
    "Fixed":    { "PermitLimit": 600, "WindowMinutes": 1, "QueueLimit": 100 },
    "FixedByIp":{ "PermitLimit": 450, "WindowMinutes": 1, "QueueLimit": 50 },
    "Auth":     { "TokenLimit": 10, "ReplenishmentPeriodMinutes": 1, "TokensPerPeriod": 5 },
    "Global":   { "PermitLimit": 1000, "WindowMinutes": 1, "QueueLimit": 200 },
    "Api":      { "PermitLimit": 500, "WindowMinutes": 1, "SegmentsPerWindow": 6, "QueueLimit": 50 },
    "Refresh":  { "PermitLimit": 20, "WindowMinutes": 15, "QueueLimit": 0 },
    "PerUser":  { "PermitLimit": 300, "WindowMinutes": 1, "QueueLimit": 50 }
  }
}
