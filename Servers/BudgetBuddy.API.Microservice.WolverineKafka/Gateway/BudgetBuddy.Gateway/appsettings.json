{
  "Keycloak": {
    "Authority": "http://keycloak:8080/realms/budgetbuddy",
    "Audience": "budgetbuddy-api",
    "RequireHttps": false
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://jaeger:4317"
  },
  "Seq": {
    "ServerUrl": "http://seq:5341"
  },
  "ReverseProxy": {
    "Routes": {
      "accounts-route": {
        "ClusterId": "accounts-cluster",
        "Match": { "Path": "/api/accounts/{**catch-all}" },
        "AuthorizationPolicy": "default"
      },
      "transactions-route": {
        "ClusterId": "transactions-cluster",
        "Match": { "Path": "/api/transactions/{**catch-all}" },
        "AuthorizationPolicy": "default"
      },
      "transfers-route": {
        "ClusterId": "transactions-cluster",
        "Match": { "Path": "/api/transfers/{**catch-all}" },
        "AuthorizationPolicy": "default"
      },
      "budgets-route": {
        "ClusterId": "budgets-cluster",
        "Match": { "Path": "/api/budgets/{**catch-all}" },
        "AuthorizationPolicy": "default"
      },
      "budget-alerts-route": {
        "ClusterId": "budgets-cluster",
        "Match": { "Path": "/api/budget-alerts/{**catch-all}" },
        "AuthorizationPolicy": "default"
      },
      "investments-route": {
        "ClusterId": "investments-cluster",
        "Match": { "Path": "/api/investments/{**catch-all}" },
        "AuthorizationPolicy": "default"
      },
      "portfolio-route": {
        "ClusterId": "investments-cluster",
        "Match": { "Path": "/api/portfolio/{**catch-all}" },
        "AuthorizationPolicy": "default"
      },
      "dashboard-route": {
        "ClusterId": "analytics-cluster",
        "Match": { "Path": "/api/dashboard/{**catch-all}" },
        "AuthorizationPolicy": "default"
      },
      "reports-route": {
        "ClusterId": "analytics-cluster",
        "Match": { "Path": "/api/reports/{**catch-all}" },
        "AuthorizationPolicy": "default"
      },
      "categories-route": {
        "ClusterId": "referencedata-cluster",
        "Match": { "Path": "/api/categories/{**catch-all}" },
        "AuthorizationPolicy": "default"
      },
      "category-types-route": {
        "ClusterId": "referencedata-cluster",
        "Match": { "Path": "/api/category-types/{**catch-all}" },
        "AuthorizationPolicy": "default"
      },
      "currencies-route": {
        "ClusterId": "referencedata-cluster",
        "Match": { "Path": "/api/currencies/{**catch-all}" },
        "AuthorizationPolicy": "default"
      },
      "prices-route": {
        "ClusterId": "financial-cluster",
        "Match": { "Path": "/api/prices/{**catch-all}" }
      },
      "keycloak-route": {
        "ClusterId": "keycloak-cluster",
        "Match": { "Path": "/auth/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/auth" }
        ]
      }
    },
    "Clusters": {
      "accounts-cluster":      { "Destinations": { "primary": { "Address": "http://accounts-service:8080" } } },
      "transactions-cluster":  { "Destinations": { "primary": { "Address": "http://transactions-service:8080" } } },
      "budgets-cluster":       { "Destinations": { "primary": { "Address": "http://budgets-service:8080" } } },
      "investments-cluster":   { "Destinations": { "primary": { "Address": "http://investments-service:8080" } } },
      "analytics-cluster":     { "Destinations": { "primary": { "Address": "http://analytics-service:8080" } } },
      "referencedata-cluster": { "Destinations": { "primary": { "Address": "http://referencedata-service:8080" } } },
      "financial-cluster":     { "Destinations": { "primary": { "Address": "http://financial-service:8080" } } },
      "keycloak-cluster":      { "Destinations": { "primary": { "Address": "http://keycloak:8080" } } }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft": "Warning", "System": "Warning" }
    }
  }
}
