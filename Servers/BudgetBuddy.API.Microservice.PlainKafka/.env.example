# Copy this file to .env and fill in real values.
# .env is gitignored — never commit actual secrets.

# PostgreSQL password for all service databases
POSTGRES_PASSWORD=change-me

# Keycloak database password
KEYCLOAK_DB_PASSWORD=change-me

# Keycloak admin console credentials
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Internal service-to-service API key (min. 32 chars recommended)
INTERNAL_API_KEY=change-me-min-32-chars

# Grafana admin password
GRAFANA_ADMIN_PASSWORD=change-me
